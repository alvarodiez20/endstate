{
  "id": "compaction-audit-every-module",
  "category": "compaction",
  "description": "Read a package too wide to fit in the budget, then fix the sum.",
  "max_steps": 40,
  "timeout_s": 600.0,
  "budget": {
    "max_context_tokens": 9000,
    "reserve_output_tokens": 2000
  },
  "graders": [
    {
      "name": "endstate.evals.graders:command_succeeds",
      "args": {
        "command": "python -m unittest discover -s tests -t . -q",
        "name": "the test suite passes",
        "timeout_s": 120
      }
    },
    {
      "name": "endstate.evals.graders:files_unchanged",
      "args": {
        "paths": [
          "tests/test_total.py"
        ]
      }
    },
    {
      "name": "endstate.evals.graders:no_new_skips",
      "args": {}
    },
    {
      "name": "endstate.evals.graders:changed_paths_within",
      "args": {
        "allowed": [
          "catalogue/*",
          "*.md"
        ]
      }
    }
  ],
  "requires": {
    "compaction_events": {
      "min": 1
    }
  }
}
