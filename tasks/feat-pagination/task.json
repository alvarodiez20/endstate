{
  "id": "feat-pagination",
  "category": "feature",
  "description": "Add pagination and use it from two listing endpoints.",
  "max_steps": 25,
  "timeout_s": 600.0,
  "budget": {
    "max_context_tokens": 60000,
    "reserve_output_tokens": 4000
  },
  "graders": [
    {
      "name": "endstate.evals.graders:command_succeeds",
      "args": {
        "command": "python -m unittest discover -s tests -t . -q",
        "name": "the test suite passes",
        "timeout_s": 120
      }
    },
    {
      "name": "endstate.evals.graders:paths_exist",
      "args": {
        "paths": [
          "apikit/pagination.py"
        ]
      }
    },
    {
      "name": "endstate.evals.graders:files_unchanged",
      "args": {
        "paths": [
          "tests/test_pagination.py",
          "apikit/store.py"
        ]
      }
    },
    {
      "name": "endstate.evals.graders:pattern_count",
      "args": {
        "pattern": "^\\s*(from|import)\\s+apikit\\.pagination",
        "paths": [
          "apikit/users.py",
          "apikit/orders.py"
        ],
        "minimum": 2,
        "name": "both endpoints use the pagination module"
      }
    },
    {
      "name": "endstate.evals.graders:no_new_skips",
      "args": {}
    },
    {
      "name": "endstate.evals.graders:changed_paths_within",
      "args": {
        "allowed": [
          "apikit/*",
          "*.md"
        ]
      }
    }
  ]
}
